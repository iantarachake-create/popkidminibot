PORT=3000
# Postgres connection string. When set, ALL users' sessions + settings are stored in the database.
# On Render: paste the *Internal* Database URL here (Environment tab), never into code or chat.
DATABASE_URL=
# Set to false only if your database does not use SSL
DATABASE_SSL=
# Strongly recommended with a database: encrypts stored WhatsApp credentials (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If you lose this key, stored sessions cannot be read — keep a copy somewhere safe.
ENCRYPTION_KEY=
# Used only when DATABASE_URL is empty (local files; needs a persistent disk)
SESSIONS_DIR=./sessions
# Hard cap on simultaneous sessions (size to your RAM)
MAX_SESSIONS=50
# Delay between session restores at boot (ms) - avoids a reconnect stampede
RESTORE_STAGGER_MS=2500
# Command prefix for every session
PREFIX=.
# Public URL for self-ping on sleepy hosts, e.g. https://yourapp.onrender.com
SELF_URL=
# Enables /api/admin/* (list/remove sessions). Or use ADMIN_PASSWORD_HASH (bcrypt)
ADMIN_PASSWORD=
# Optional: newsletter JID every new session follows on connect (opt-in)
FOLLOW_CHANNEL=
# Optional: comma-separated numbers treated as dev (isDev) on EVERY session
DEV_NUMBERS=
